# OBD Analyzer environment.
#
# The app runs completely client-side with NO configuration at all. Everything below
# is for the OPTIONAL "share a log via an expiring link" feature. Leave it unset and
# the Share button stays hidden — nothing ever leaves the browser.

# ---- Sharing (optional) ----------------------------------------------------------

# Show the Share button in the UI. Only set this to "true" if you have also configured
# the server variables below; otherwise sharing will be advertised but fail.
NEXT_PUBLIC_SHARING_ENABLED=

# Supabase project that stores shared logs. Create the table first with
# scripts/share-schema.sql.
#
# IMPORTANT: this is the SERVICE-ROLE key, not the anon key. It is used ONLY by the
# server-side route handler (app/api/share) and is never exposed to the browser. Keep
# it secret and set it in your host's encrypted environment, never in NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning.
# How long a shared link stays valid, in hours (default 24).
SHARE_TTL_HOURS=24
# Largest log accepted for sharing, in bytes of raw CSV (default 2,000,000 ≈ 2 MB).
SHARE_MAX_BYTES=2000000
